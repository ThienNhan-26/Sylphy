{
  "name": "sylphy-avatar-runtime",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "desktop:build": "npm run build",
    "desktop": "electron .",
    "desktop:dev": "npm run build && electron .",
    "desktop:install": "npm install"
  },
  "dependencies": {
    "@pixiv/three-vrm": "3.5.5",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "electron": "^37.2.6"
  },
  "main": "desktop/main.cjs",
  "allowScripts": {
    "electron@37.10.3": true
  }
}
