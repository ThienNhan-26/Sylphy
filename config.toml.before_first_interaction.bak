[sylphy]
data_dir = "data"
log_dir = "logs"
database_name = "sylphy.sqlite3"

[ollama]
host = "http://127.0.0.1:11434"
model = "jarvis-uncen:latest"
timeout_seconds = 120
context_budget = 8192
system_instructions = "Follow the configured SYLPHY identity while grounding statements in available context. Be honest about uncertainty, memory, and capabilities. Application-enforced privacy, permission, and delivery boundaries take precedence over conversational style."
identity_file = "identity.toml"

[memory]
enabled = true
context_budget = 512
max_items = 5

[runtime]
heartbeat_enabled = true
heartbeat_interval_seconds = 30

[resources]
max_concurrent_generations = 1

[cognition]
enabled = true
max_candidates_per_turn = 3
max_context_messages = 6
max_pending_tasks = 100
shutdown_grace_seconds = 5

[presence]
enabled = true
queue_capacity = 20

[companion]
enabled = false

[avatar]
enabled = true
asset_path = "assets/avatar/sylphy.png"
allow_external_asset = false
width = 240
height = 320
always_on_top = true
start_visible = false

[exploration]
enabled = false
max_queue_items = 20
cooldown_seconds = 3600
max_attempts_per_period = 3
period_seconds = 86400
question_max_length = 400
context_max_chars = 8000
question_expiry_days = 30

[vision]
enabled = true
model = "lfm3-vl:2b-q8_0"
camera_index = 0
capture_timeout_seconds = 5
max_width = 1280
max_height = 1280
jpeg_quality = 85
max_image_bytes = 1500000
inference_timeout_seconds = 90

[voice]
enabled = true
